# Copy to .env and adjust. Never commit the real .env file.

# SQLite database file (relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with:  npx auth secret
# (server-only — never prefix with NEXT_PUBLIC_)
AUTH_SECRET="replace-with-a-long-random-string"

# Trust the Host header (needed behind a reverse proxy or in Docker).
AUTH_TRUST_HOST=true

# Public base URL, used for absolute links and metadata. Safe to expose.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Demo mode: shows demo accounts on the login page and displays password-reset
# links on screen instead of emailing them. Set to false in production.
DEMO_MODE=true

# Set to true only when the site is served over HTTPS: adds HSTS and
# upgrade-insecure-requests to the security headers.
ENABLE_HTTPS_HEADERS=false
